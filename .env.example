# BCMS Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Application
APP_NAME="Building Construction Management System"
APP_ENV=development
APP_URL=http://localhost/bcms/public
APP_KEY=change_this_to_a_random_32_char_string

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bcms_db
DB_USERNAME=root
DB_PASSWORD=

# Session
SESSION_LIFETIME=7200
SESSION_NAME=bcms_session

# Security
BCRYPT_ROUNDS=12
